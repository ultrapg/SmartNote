<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmartNote" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.SmartNote.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FBF8FF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SmartNote</item>
    </style>

    <style name="Theme.SmartNote.ShareSheet" parent="Theme.SmartNote">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
    </style>
</resources>
